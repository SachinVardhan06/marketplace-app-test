{
  "name": "marketplace-app-test",
  "version": "0.1.0",
  "private": true,
  "description": "Two-tab Chrome environment for in-scope Atlassian Marketplace bug bounty work: passive app recon plus traffic capture on your own test site.",
  "main": "src/hunt.js",
  "scripts": {
    "hunt": "node src/hunt.js",
    "hunt:headless": "node src/hunt.js --headless",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "leads": "node src/analyze.js",
    "agent": "node src/hunt-agent.js",
    "baseline": "node src/baseline.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "playwright": "^1.47.0"
  }
}
