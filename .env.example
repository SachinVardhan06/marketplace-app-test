# Copy to .env (which is gitignored) and fill in. NEVER commit .env, and never
# paste these values into a chat — the tool reads them from here.
#
# API tokens: https://id.atlassian.com/manage-profile/security/api-tokens
# Create one per account, while signed in as that account. Use dedicated test
# users, not your own account: an Atlassian API token can act on every site its
# user belongs to.

# Your own Jira Cloud test site, with the app under test installed.
# (It can also live in config.json as "testSite", which wins over this.)
HUNT_SITE=https://your-own-site.atlassian.net
# A second site of your own, only needed for cross-instance checks. Leave empty.
HUNT_SECOND_SITE=

# Account A — the Jira admin on your test site.
# ACCOUNT_A_EMAIL / ACCOUNT_A_TOKEN are accepted as aliases for these two.
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=

# Account B — a second, deliberately LOW-PRIVILEGE user on the same site.
# Most access-control tests are "do this as B and see if the app over-shares".
# ACCOUNT_B_EMAIL / ACCOUNT_B_TOKEN are accepted as aliases.
ATLASSIAN_EMAIL_B=second-user@example.com
ATLASSIAN_API_TOKEN_B=
